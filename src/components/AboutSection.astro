---
import ArrowUpRight from "../assets/icons/arrow_up_right.svg";
---

<div class="container about" id="about">
    <div>
        <h2 class="about__label">A little about me</h2>
        <p class="about__story">
            I design and code simple, usable interfaces, and I love watching a
            rough sketch turn into a living page on the web. Away from the
            screen I'm learning to draw again, baking bread and desserts,
            running, cycling, and learning to work on my own Mazda MX-5 NB.
        </p>
    </div>
</div>

<style>
    .about {
        display: grid;
        margin-bottom: 12rem;
        gap:2rem;
    }
    .about__label {
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.8;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }


    .about__story {
        font-size: clamp(1.563rem, 1.2703rem + 1.4633vw, 2.441rem);
        text-align: left;
        font-weight: 500;
        line-height: 1.3;
    }
    @media (min-width: 1024px) {
        .about {
            margin-bottom: 24rem;
        }
    }
</style>
