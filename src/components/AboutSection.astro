---
import ArrowUpRight from "../assets/icons/arrow_up_right.svg";
---

<div class="container about" id="about">
    <div>
        <h2 class="about__label">A little about me</h2>
        <p class="about__story">
            I design and code simple, usable interfaces, and my favourite part is taking a design and turning it into
            something people can actually use. Away from the screen you'll find me drawing, baking, running, cycling or
            under the hood of my Mazda MX-5NB
        </p>
    </div>
</div>

<style>
    .about {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 4rem;
    }
    .about__label {
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.8;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .about__story {
        font-size: clamp(1.563rem, 1.2703rem + 1.4633vw, 2.441rem);
        text-align: left;
        font-weight: 500;
        line-height: 1.3;
    }
</style>
