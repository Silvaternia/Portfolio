---
import ArrowUpRight from "../assets/icons/arrow_up_right.svg";
// ToDo: Decide on contact CTA btn animation
---

<div class="container about">
    <div class="about__intro">
        <h2>A little about me</h2>
        <a href="mailto:" class="about__cta"
            >Get in Touch <span class="about__cta-icon" aria-hidden="true">
                <ArrowUpRight width={20} height={20} focusable="false" />
            </span></a
        >
    </div>
    <p class="about__story">
        I design and build simple, polished interfaces with usability in mind.
        Outside of my work, I'll usually be running or tinkering on my Mazda mx
        5. Back at my desk, you might find me playing Palword.
    </p>
</div>

<style>
    .about {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        margin-bottom: 18rem;
        gap: 0.5rem;
    }
    .about__intro {
        display: grid;
        row-gap: 4rem;
    }
    .about__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-charcoal);
        color: var(--color-off-white);
        padding: 0.75rem 1.5rem;
        width: fit-content;
        height: fit-content;
        border-radius: 1.175rem;
        column-gap: 0.5rem;
    }

    .about__cta-icon {
        display: inline-flex;
        flex-shrink: 0;
        transition: transform 200ms ease-out;
    }
    .about__cta:is(:hover, :focus-visible) .about__cta-icon {
        transform: translate(4px, -4px);
    }

    .about__cta:focus-visible {
        outline: 2px solid var(--color-charcoal);
        outline-offset: 4px;
    }

    .about__story {
        font-size: clamp(1.5625rem, 1.4323rem + 0.651vw, 1.953125rem);
        text-align: left;
        line-height: 1.3;
    }

    @media (prefers-reduced-motion: reduce) {
        .about__cta-icon {
            transition: none;
        }

        .about__cta:is(:hover, :focus-visible) .about__cta-icon {
            transform: none;
        }
    }
</style>
