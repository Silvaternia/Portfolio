---
import ProjectRow from "./ProjectBar.astro";
import { projects } from "../data/projects.ts";
---

<section class="showcase container">
    <div>
        <h2 id="projects" class="showcase__title">Featured work</h2>
    </div>
    <div class="showcase__content">
        {projects.map((project) => <ProjectRow project={project} />)}
    </div>
</section>

<style>
    .showcase {
        margin-block: 6rem 8rem;
    }
    .showcase__title {
        text-align: left;
        line-height: 1.1;
    }
    .showcase__content {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @media (min-width: 640px) {
        .showcase__content {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .showcase__content {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .showcase__title {
            margin-bottom: 1rem;
        }
    }
</style>
