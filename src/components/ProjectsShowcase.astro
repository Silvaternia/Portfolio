---
import ProjectRow from "./ProjectRow.astro";
import placeHolderImg from "../assets/images/projectImg.png";
type Project = {
    Name: string;
    Description: string;
    ImageUrl: ImageMetadata;
    type: string;
    Stack: string[];
    Role: string;
    Timeline: string;
};

const Projects: Project[] = [
    {
        Name: "123meekijken",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        type: "B2B marketing website",
        Stack: ["Front-end", "Tailwindcss", "Django"],
        Role: "Front-end developer",
        Timeline: "09/2025 - present",
    },
    {
        Name: "WeSeeDo",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        type: "B2B marketing website",
        Stack: ["Django", "full-stack", "WagtailCMS"],
        Role: "Front-end developer",
        Timeline: "06/2025 - present",
    },
    {
        Name: "EvenThuis",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        type: "B2B marketing website",
        Stack: ["Django", "full-stack", "WagtailCMS"],
        Role: "Front-end & Designer",
        Timeline: "01/2025 - 06/2026",
    },
];
---

<section class="showcase container">
    <h2 id="projects" class="showcase__title">Some things I've worked on</h2>
    <div class="showcase__content">
        {Projects.map((project) => <ProjectRow project={project} />)}
    </div>
</section>

<style>
    .showcase {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-block: 6rem;
    }
    .showcase__title {
        text-align: left;
        line-height: 1.1;
        margin-bottom: 4rem;
    }
    .showcase__content {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .showcase__title {
            text-align: center;
        }
        .showcase__content {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 1024px) {
        .showcase__content {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>
<script>
    function addListeners() {
        const projectsWrapper = document.querySelector(".showcase__content");

        if (!projectsWrapper) return;
        projectsWrapper.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const card = target.closest(".card");
            if (!card) return;
            card.classList.toggle("is-active");
        });
        // projectsWrapper.addEventListener(
        //     "mouseleave",
        //     (event) => {
        //         const target = event.target;
        //         if (!(target instanceof HTMLElement)) return;
        //         const card = target.closest(".card");
        //         if (!card) return;
        //         console.log(event.target);
        //         card.classList.remove("is-active");
        //     },
        //     true,
        // );
        projectsWrapper.addEventListener("keydown", (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const card = target.closest(".card");
            if (!card) return;
            if (event.key === "Escape") {
                card.classList.remove("is-active");
            }
        });
        projectsWrapper.addEventListener("focusin", (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const card = target.closest(".card");
            if (!card) return;
            card.classList.add("is-active");
        });
        projectsWrapper.addEventListener("focusout", (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const card = target.closest(".card");
            if (!card) return;
            card.classList.add("is-active");
        });
    }
    addListeners();
</script>
