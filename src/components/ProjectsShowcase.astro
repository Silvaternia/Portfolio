---
import ProjectRow from "./ProjectBar.astro";
import placeHolderImg from "../assets/images/projectImg.png";
type Project = {
    Name: string;
    Description: string;
    ImageUrl: ImageMetadata;
    Stack: string[];
    Role: string;
    Year: string;
};

const Projects: Project[] = [
    {
        Name: "123meekijken",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        Stack: ["Front-end", "Tailwindcss", "Django"],
        Role: "Front-end developer",
        Year: "09/2025 - present",
    },
    {
        Name: "WeSeeDo",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        Stack: ["Django", "full-stack", "WagtailCMS"],
        Role: "Front-end developer",
        Year: "06/2025 - present",
    },
    {
        Name: "EvenThuis",
        Description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        ImageUrl: placeHolderImg,
        Stack: ["Django", "full-stack", "WagtailCMS"],
        Role: "Front-end & Designer",
        Year: "01/2025 - 06/2026",
    },
];
---

<section class="showcase container">
    <h2 id="projects" class="showcase__title">Featured work</h2>
    <div class="showcase__content">
        {Projects.map((project) => <ProjectRow project={project} />)}
    </div>
</section>

<style>
    .showcase {
        margin-block: 6rem 8rem;
    }
    .showcase__title {
        text-align: left;
        line-height: 1.1;
        margin-bottom: 2rem;
    }
    .showcase__content {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @media (min-width: 640px) {
        .showcase__content {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .showcase {
            margin-block: 8rem 16rem;
        }
        .showcase__content {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .showcase__title {
            margin-bottom: 5rem;
        }
    }
</style>
