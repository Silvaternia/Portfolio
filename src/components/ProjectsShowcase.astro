---
import ProjectRow from "./ProjectBar.astro";
import placeHolderImg from "../assets/images/projectImg.png";
type Project = {
    name: string;
    description: string;
    imageUrl: ImageMetadata;
    stack: string[];
    role: string;
    year: string;
    url: string;
};

const Projects: Project[] = [
    {
        name: "123meekijken",
        description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        imageUrl: placeHolderImg,
        stack: ["Front-end", "Tailwindcss", "Django"],
        role: "Front-end developer",
        year: "09/2025 - present",
        url: "https://123meekijken.nl",
    },
    {
        name: "WeSeeDo",
        description:
            "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
        imageUrl: placeHolderImg,
        stack: ["Django", "full-stack", "WagtailCMS"],
        role: "Front-end developer",
        year: "06/2025 - present",
        url: "https://.weseedo.nl",
    },
    // {
    //     name: "EvenThuis",
    //     description:
    //         "Lorem ipsum dolor sit amet consectetur. Aliquam facilisis viverra gravida ultrices amet. Ut enim eu vestibulum viverra pretium nulla.",
    //     imageUrl: placeHolderImg,
    //     stack: ["Django", "full-stack", "WagtailCMS"],
    //     role: "Front-end & Designer",
    //     year: "01/2025 - 06/2026",
    // },
];
---

<section class="showcase container">
    <div>
        <h2 id="projects" class="showcase__title">Featured work</h2>
        <p class="showcase__lead">
            W.I.P. I am currently working on proper mockups and copywriting thus, the card shall lead to their
            respective LIVE websites
        </p>
    </div>
    <div class="showcase__content">
        {Projects.map((project) => <ProjectRow project={project} />)}
    </div>
</section>

<style>
    .showcase {
        margin-block: 6rem 8rem;
    }
    .showcase__title {
        text-align: left;
        line-height: 1.1;
    }
    .showcase__lead {
        margin-bottom: 2rem;
    }
    .showcase__content {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @media (min-width: 640px) {
        .showcase__content {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .showcase {
            margin-block: 8rem 24rem;
        }
        .showcase__content {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .showcase__title {
            margin-bottom: 1rem;
        }
        .showcase__lead {
            margin-bottom: 3rem;
        }
    }
</style>
