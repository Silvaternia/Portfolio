---
import { Image } from "astro:assets";
const { project } = Astro.props;
const details = [
    ["Role", project.role],
    ["Stack", project.stack],
    ["Period", project.period],
];
---

<a
    href={`projects/${project.slug}`}
    target="_blank"
    rel="noopener"
    rel="noreferrer"
    class="card"
    aria-label=`Read about project ${project.name}`
>
    <div class="card__visual">
        <div class="card__visual-inner">
            <Image
                src={project.cover.src}
                layout="constrained"
                width={640}
                height={360}
                alt={project.cover.alt}
            />
        </div>
    </div>
    <div class="card__content">
        <div class="card__header">
            <h3 class="card__title">{project.name}</h3>
            <div class="card__description">
                <p>{project.role}</p>
                <span class="card__button-view">
                    View project <span aria-hidden="true">→</span>
                </span>
            </div>
        </div>
        <dl class="card__footer">
            {
                details.map(([label, value]) => (
                    <div class="card__details">
                        <dt class="card__details-head">{label}</dt>
                        <dd>
                            {Array.isArray(value) ? value.join(", ") : value}
                        </dd>
                    </div>
                ))
            }
        </dl>
    </div>
</a>

<style>
    .card {
        display: flex;
        flex-direction: column;
        padding: 2rem 0;
        &:focus-within {
            outline: 2px solid currentColor;
            outline-offset: 4px;
        }
    }
    .card__content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .card__header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }
    .card__title {
        margin-bottom: 0.5rem;
        padding-bottom: 0.5rem;
        border-width: 0 0 0.5px;
        border-style: solid;
        border-color: var(--color-light-gray);
        text-align: left;
    }
    .card__description {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
    }

    .card__visual {
        display: block;
        width: 100%;
        order: -1;
        height: auto;
        margin-bottom: 1rem;
        overflow: hidden;
        border-radius: 0.5rem;
    }
    .card__visual-inner {
        overflow: hidden;
        min-height: 0;
        height: auto;
        aspect-ratio: 16/9;
    }
    .card__footer {
        display: none;
        margin: 0;
    }

    .card__details {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-height: 0;
        overflow: hidden;
        font-size: clamp(0.875rem, 0.7857rem + 0.4464vw, 1rem);
    }
    .card__details-head {
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1.6;
        opacity: 0.6;
    }
    .card__details dd {
        margin: 0;
    }

    img {
        height: auto;
        aspect-ratio: 16/9;
    }

    @media (min-width: 1024px) {
        .card {
            flex-direction: row;
            justify-content: space-between;
            column-gap: 4rem;
            border-top: 0.5px solid var(--color-light-gray);
            transition: height 300ms ease;

            &:last-child {
                border-bottom: 0.5px solid var(--color-light-gray);
            }
        }
        .card__title {
            padding-bottom: 0;
            border: none;
        }
        .card__description {
            display: none;
        }
        .card__visual {
            display: grid;
            align-items: self-end;
            flex: 1 0 320px;
            max-width: 384px;
            margin: 0;
            grid-template-rows: 0fr;
            overflow: hidden;
            min-height: 0;
            order: 1;
            transition: grid-template-rows 250ms ease-in-out;
        }
        .card__footer {
            display: grid;
            grid-template-columns: repeat(3, auto);
            grid-template-rows: 0fr;
            gap: 4rem;
            min-height: 0;
            overflow: hidden;
            opacity: 0;
            transition:
                grid-template-rows 350ms ease-in-out,
                opacity 200ms ease-in-out;
        }

        .card:is(:hover, :focus-within) .card__footer {
            grid-template-rows: 1fr;
            opacity: 1;
        }
        .card:is(:hover, :focus-within) .card__visual {
            grid-template-rows: 1fr;
            outline: 0.5px solid rgb(from var(--color-light-gray) r g b / 0.8);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .card__footer {
            transition: none;
        }
    }
</style>
