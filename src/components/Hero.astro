---
// import ArrowDown from "../assets/icons/arrow_down.svg";
import MaiilIcon from "../assets/icons/mail.svg";
---

<header class="hero container">
    <div class="hero__content">
        <div class="hero__intro">
            <h1 class="hero__title">BOUKE SIKKEMA</h1>
            <p class="hero__lead">Front-end developer. based in the Netherlands</p>
            <a
                href="mailto:hello@boukesikkema.nl?subject=Front-end%20job%20opportunity"
                class="availability"
                aria-label="Open to front-end roles. Get in touch."
            >
                <span class="availability__dot" aria-hidden="true"></span>
                <span class="availability__rotator">
                    <span class="availability__label availability__label--front"> Open to front-end roles </span>
                    <span class="availability__label availability__label--bottom">
                        Get in touch<MaiilIcon width={16} height={16} />
                    </span>
                </span>
            </a>
        </div>
    </div>
    <div class="hero__work-link">
        <p>[scroll and explore]</p>
    </div>
</header>

<style>
    .hero {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero__content {
        flex: 1;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .hero__intro {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero__title {
        position: relative;
        margin: 0 0 0.5rem;
        /* reminder: vw width starts at 768 max 1280 */
        font-size: clamp(4rem, 1.6225rem + 4.9531vw, 7.47rem);
        line-height: 1;
        letter-spacing: -0.02em;
        font-weight: 700;
    }
    .hero__title::before {
        color: var(--color-text);
        opacity: 0.7;
        content: "Not Bauke!";
        position: absolute;
        font-size: clamp(1rem, 0.9167rem + 0.4167vw, 1.25rem);
        font-weight: 600;
        top: -0.5em;
        left: 0;
        letter-spacing: 0.2em;
        transform: translateY(-50%);
        font-style: italic;
    }

    .hero__lead {
        font-size: clamp(1.25rem, 1.0156rem + 1.1719vw, 1.953125rem);
        line-height: 1.35;
        max-width: 35ch;
        text-align: left;
        margin-bottom: 2em;
    }
    .availability {
        --label-height: 1.5rem;
        --face-depth: calc(var(--label-height) / 2);

        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1rem;
        perspective: 800px;
    }
    .availability__dot {
        width: 0.5rem;
        height: 0.5rem;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: #26d867;
    }
    .availability__rotator {
        display: grid;
        width: max-content;
        height: var(--label-height);
        transform-style: preserve-3d;
        transform: translateZ(calc(-1 * var(--face-depth))) rotateX(0deg);
        transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .availability__label {
        position: static;
        inset: auto;
        width: auto;
        grid-area: 1 / 1;

        display: flex;
        align-items: center;
        justify-content: flex-start;
        column-gap: 0.5rem;
        white-space: nowrap;
        backface-visibility: hidden;
    }
    .availability__label--front {
        transform: translateZ(var(--face-depth));
    }

    .availability__label--bottom {
        transform: rotateX(-90deg) translateZ(var(--face-depth));
    }
    .availability:is(:hover, :focus-visible) .availability__rotator {
        transform: translateZ(calc(-1 * var(--face-depth))) rotateX(90deg);
    }

    .availability:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    .hero__work-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 1rem;
        opacity: 0.8;

        margin-block: 2rem;
    }

    @media (min-width: 640px) {
        .hero__lead {
            text-align: center;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .availability__rotator {
            transition: none;
        }
    }
</style>
