---
import MenuIcon from "../assets/icons/bars-solid-full.svg";
import ArrowUpRight from "../assets/icons/arrow_up_right.svg";
---

<div class="container navigation__wrapper">
    <nav class="navigation glass" aria-label="Main">
        <div class="navigation__bar">
            <a class="navigation__link-home" href="/">@Bouke</a>

            <ul class="navigation__nav-list">
                <li><a class="navigation__link" href="#projects">My Work</a></li>
                <li><a class="navigation__link" href="#about">About me</a></li>
            </ul>
            <a class="navigation__link-cta" href="mailto:hello@boukesikkema.nl?subject=Hello%20Bouke"
                >Get in touch
                <ArrowUpRight
                    class="navigation__cta-icon"
                    width={16}
                    height={16}
                    aria-hidden="true"
                    fill="currentColor"
                /></a
            >
            <button
                class="navigation__mobile-trigger"
                aria-label="Open navigation"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <MenuIcon width={40} height={40} fill="currentColor" />
            </button>
        </div>

        <div class="navigation__drawer" id="mobile-menu">
            <div class="navigation__drawer-inner">
                <ul class="mobile__nav-list">
                    <li>
                        <a class="mobile__link" href="#projects">
                            Work <ArrowUpRight width={16} height={16} aria-hidden="true" fill="currentColor" />
                        </a>
                    </li>
                    <li>
                        <a class="mobile__link" href="#about">
                            About me <ArrowUpRight width={16} height={16} aria-hidden="true" fill="currentColor" />
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</div>

<style>
    .navigation__wrapper {
        position: fixed;
        inset-inline: 0;
        top: var(--navbar-top-pos);
        z-index: 100;
        margin-inline: auto;
    }

    .glass {
        background: rgba(255, 255, 255, 0.06);
        border-radius: 2.5rem;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(3.4px);
        -webkit-backdrop-filter: blur(3.4px);
        border: 1px solid rgba(255, 255, 255, 0.22);
    }

    .navigation {
        color: var(--color-text);
    }
    .navigation__link-home {
        width: fit-content;
    }
    .navigation__bar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding-inline: 2rem;
        height: var(--navbar-height);
    }

    .navigation__nav-list {
        list-style: none;
        display: none;
    }

    .navigation__link:hover {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    .navigation__link-cta {
        display: none;
    }

    .navigation__mobile-trigger {
        border: none;
        background-color: transparent;
        justify-self: end;
        color: inherit;
        cursor: pointer;
    }

    .navigation__drawer {
        display: grid;
        grid-template-rows: 0fr;
        visibility: hidden;
        transition:
            grid-template-rows 350ms ease-in-out,
            visibility 0s 350ms;
    }

    .navigation__drawer-inner {
        min-height: 0;
        overflow: hidden;
    }

    .mobile__nav-list {
        list-style: none;
        display: grid;
        row-gap: 1.5rem;
        padding: 0.5rem 2rem 1.5rem;
    }

    .mobile__link {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navigation--open .navigation__drawer {
        grid-template-rows: 1fr;
        visibility: visible;
        transition:
            grid-template-rows 350ms ease-in-out,
            visibility 0s;
    }

    @media (min-width: 640px) {
        .navigation__bar {
            grid-template-columns: 1fr auto 1fr;
        }
        .navigation__nav-list {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 0 2rem;
        }
        .navigation__mobile-trigger {
            display: none;
        }
        .navigation__link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            justify-self: end;
        }
        .navigation__drawer {
            display: none;
        }

        .navigation__cta-icon {
            flex-shrink: 0;
            opacity: 0;
            transform: translate(-4px, 4px);

            transition:
                opacity 200ms ease,
                transform 200ms ease;
        }

        .navigation__link-cta:is(:hover, :focus-visible) .navigation__cta-icon {
            opacity: 1;
            transform: translate(0, 0);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .navigation__cta-icon {
            transition: none;
            transform: none;
        }
    }
</style>

<script>
    function initMobileMenu() {
        const navigation = document.querySelector<HTMLElement>(".navigation");
        const trigger = document.querySelector<HTMLButtonElement>(".navigation__mobile-trigger");
        if (!navigation || !trigger) return;

        function setOpen(open: boolean) {
            navigation!.classList.toggle("navigation--open", open);
            trigger!.setAttribute("aria-expanded", String(open));
            trigger!.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        }

        trigger.addEventListener("click", () => {
            setOpen(!navigation.classList.contains("navigation--open"));
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && navigation.classList.contains("navigation--open")) {
                setOpen(false);
                trigger.focus();
            }
        });
    }
    initMobileMenu();
</script>
