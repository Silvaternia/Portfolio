---
import AstroLogo from "../assets/icons/astro.svg";
import TailwindLogo from "../assets/icons/tailwind-css.svg";
import FigmaLogo from "../assets/icons/figma.svg";
import GitLogo from "../assets/icons/git.svg";
import PythonLogo from "../assets/icons/python.svg";
import JavaScriptLogo from "../assets/icons/javascript.svg";
import HTML5Logo from "../assets/icons/html5.svg";
import CSSLogo from "../assets/icons/css.svg";

const tools = [
    { name: "HTML", Logo: HTML5Logo },
    { name: "CSS", Logo: CSSLogo },
    { name: "Figma", Logo: FigmaLogo },
    { name: "JavaScript", Logo: JavaScriptLogo },
    { name: "Tailwind CSS", Logo: TailwindLogo },
    { name: "Astro", Logo: AstroLogo },
    { name: "Git", Logo: GitLogo },
    { name: "Python", Logo: PythonLogo },
];
---

<div class="container skill">
    <div class="skill__body">
        <h2 class="skill__heading">What I work with</h2>
        <div class="skill__logos" aria-hidden="true">
            {
                tools.map(({ name, Logo }) => (
                    <div class="skill__logo" data-tool={name}>
                        <Logo width={112} height={112} />
                    </div>
                ))
            }
        </div>
    </div>
    <ul class="skill__list">
        {
            tools.map(({ name }) => (
                <li class="skill__item">
                    <button type="button" class="skill__button" data-tool={name}>
                        {name}
                    </button>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .skill {
        display: grid;
        margin-bottom: 10rem;
        gap: 3rem;
    }
    .skill__body {
        display: flex;
        flex-direction: column;
    }
    .skill__heading {
        display: grid;
        row-gap: 4rem;
        flex-grow: 1;
    }
    .skill__list {
        display: grid;
        gap: 1rem;
    }
    .skill__item {
        color: var(--color-text);
        font-weight: 800;
        font-size: clamp(2rem, 1.2487rem + 3.7567vw, 3.051875rem);
        font-weight: 800;
    }
    .skill__button {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;

        opacity: 0.8;
        transition: opacity 200ms ease;
    }
    .skill__button--active {
        opacity: 1;
    }

    .skill__button:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 0.25rem;
    }
    .skill__logos {
        display: none;
    }

    @media (min-width: 768px) {
        .skill {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
        }
        .skill__logos {
            display: inline-block;
            position: relative;
        }
        .skill__logo {
            position: absolute;
            left: 0;
            bottom: 0;
            opacity: 0;
            visibility: hidden;
            padding: 1.5rem;
            border: 0.5px solid rgb(from var(--color-light-gray) r g b / 0.6);
            border-radius: 0.5rem;

            transition:
                opacity 200ms ease,
                visibility 0s linear 200ms;
        }
        .skill__logo--active {
            opacity: 1;
            visibility: visible;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .skill__button {
            transition: none;
        }
    }
</style>

<script>
    const desktop = window.matchMedia("(width >= 768px)");
    (() => {
        const skillList = document.querySelector(".skill__list");
        let activeLogo: Element | null;
        let activeType: Element | null;

        if (!skillList) return;

        skillList.addEventListener("pointerover", (event) => {
            if (!desktop.matches) return;
            if (!(event.target instanceof HTMLElement)) return;

            const target = event.target.closest(".skill__button");
            if (!target) return;
            const skillType = target.getAttribute("data-tool");
            const skillLogo = document.querySelector(`.skill__logo[data-tool="${skillType}"]`);
            if (!skillLogo || skillLogo === activeLogo) return;
            activeLogo?.classList.remove("skill__logo--active");
            activeType?.classList.remove("skill__button--active");

            skillLogo.classList.add("skill__logo--active");
            target.classList.add("skill__button--active");

            activeLogo = skillLogo;
            activeType = target;
        });
    })();
</script>
