---
// ToDo: Hide icons on mobile + hide interation
import AstroLogo from "../assets/icons/astro.svg";
import TailwindLogo from "../assets/icons/tailwind-css.svg";
import FigmaLogo from "../assets/icons/figma.svg";
import GitLogo from "../assets/icons/git.svg";
import PythonLogo from "../assets/icons/python.svg";
import JavaScriptLogo from "../assets/icons/javascript.svg";
import HTML5Logo from "../assets/icons/html5.svg";
import CSSLogo from "../assets/icons/css.svg";

const tools = [
    { name: "HTML", Logo: HTML5Logo },
    { name: "CSS", Logo: CSSLogo },
    { name: "Figma", Logo: FigmaLogo },
    { name: "JavaScript", Logo: JavaScriptLogo },
    { name: "Tailwind CSS", Logo: TailwindLogo },
    { name: "Astro", Logo: AstroLogo },
    { name: "Git", Logo: GitLogo },
    { name: "Python", Logo: PythonLogo },
];
---

<div class="container skill">
    <div class="skill__header">
        <div class="skill__intro">
            <h2>What I work with</h2>
        </div>
        <div class="skill__logos" aria-hidden="true">
            {
                tools.map(({ name, Logo }) => (
                    <div class="skill__logo" data-tool={name}>
                        <Logo width={128} height={128} />
                    </div>
                ))
            }
        </div>
    </div>
    <ul class="skill__list">
        {
            tools.map(({ name }) => (
                <li class="skill__item">
                    <button type="button" class="skill__button" data-tool={name}>
                        {name}
                    </button>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .skill {
        display: grid;
        margin-bottom: 18rem;
        gap: 3rem;
        text-align: center;
    }
    .skill__header {
        display: flex;
        flex-direction: column;
    }
    .skill__intro {
        display: grid;
        row-gap: 4rem;
        flex-grow: 1;
    }
    .skill__list {
        display: grid;
        gap: 1rem;
    }
    .skill__item {
        color: var(--color-text);
        font-weight: 800;
        font-size: clamp(2rem, 1.2487rem + 3.7567vw, 3.051875rem);
        font-weight: 800;
    }
    .skill__button {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;

        opacity: 0.5;
        transition: opacity 200ms ease;
    }
    .skill__button:is(:hover, :focus-visible) {
        opacity: 1;
    }

    .skill__button:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 0.25rem;
    }
    .skill__logos {
        position: relative;
    }
    .skill__logo {
        position: absolute;
        left: 0;
        bottom: 0;
        opacity: 0;
        visibility: hidden;
        padding: 1rem;
        background-color: black;
        border-radius: 0.5rem;

        transition:
            opacity 200ms ease,
            visibility 0s linear 200ms;
    }
    .skill__logo--active {
        opacity: 1;
        visibility: visible;
    }

    @media (min-width: 768px) {
        .skill {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
            text-align: left;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .skill__button {
            transition: none;
        }
    }
</style>

<script>
    (() => {
        const skillList = document.querySelector(".skill__list");
        let activeEl: HTMLElement;

        if (!skillList) return;
        skillList.addEventListener("pointerover", (event) => {
            if (!(event.target instanceof HTMLElement)) return;
            const target = event.target.closest(".skill__button");
            if (!target) return;
            let skillLogo = document.querySelector(`[data-tool="${target.textContent}"]`);
            if (!skillLogo) return;
            if (!activeEl) {
                activeEl = skillLogo;
                activeEl.classList.add("skill__logo--active");
            } else if (activeEl !== skillLogo) {
                activeEl.classList.remove("skill__logo--active");
                activeEl = skillLogo;
                activeEl.classList.add("skill__logo--active");
            }
        });
    })();
</script>
